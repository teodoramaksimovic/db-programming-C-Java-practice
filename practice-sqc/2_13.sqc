/*
Zadatak 2.13: Napisati C/SQL program kojim se ukida uslovnost svih predmeta koji su uslovni da bi se položio predmet 
čiji se identifikator unosi sa standardnog ulaza.
*/
#include <stdio.h>
#include <stdlib.h>
#include <string.h>

EXEC SQL INCLUDE SQLCA;

EXEC SQL BEGIN DECLARE SECTION;
char db_name[20];
char db_user[20];
char db_pass[20];
sqlint32 idpredmeta;
EXEC SQL END DECLARE SECTION;

void checkSQL(const char *str)
{
    if (SQLCODE < 0) {
        fprintf(stderr, "Greska %d: %s\n", SQLCODE, str);

        EXEC SQL ROLLBACK;
        EXEC SQL CONNECT RESET;

        exit(EXIT_FAILURE);
    }
}

int main()
{
    strcpy(db_name, getenv("DB_NAME"));
    strcpy(db_user, getenv("DB_USER"));
    strcpy(db_pass, getenv("DB_PASS"));
    EXEC SQL CONNECT TO :db_name USER :db_user USING :db_pass;

    checkSQL("Konekcija na bazu podataka");
    
    printf("Unesite id predmeta: ");
    scanf("%d", &idpredmeta);

    EXEC SQL 
        DELETE FROM DA.USLOVNIPREDMET UP
        WHERE UP.IDPREDMETA = :idpredmeta;
    checkSQL("DELETE");

    EXEC SQL CONNECT RESET;
    checkSQL("RESET");

    return 0;
}