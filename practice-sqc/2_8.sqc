/*
Zadatak 2.8: Napisati C/SQL program kojim se dodaje da je za polaganje predmeta čiji je identifikator 2343 uslov da se položi predmet čiji je 
identifikator 2327, na studijskom programu sa identifikatorom 103.
*/

#include <stdio.h>
#include <string.h>
#include <stdlib.h>

EXEC SQL INCLUDE SQLCA;

EXEC SQL BEGIN DECLARE SECTION;
char db_name[20];
char db_user[20];
char db_pass[20];
EXEC SQL END DECLARE SECTION;

void checkSQL(const char *str) {
    if(SQLCODE < 0) {
        fprintf(stderr, "Greska %d: %s\n", SQLCODE, str);

        EXEC SQL CONNECT RESET;
        exit(EXIT_FAILURE);
    }
}

int main()
{
    strcpy(db_name, getenv("DB_NAME"));
    strcpy(db_user, getenv("DB_USER"));
    strcpy(db_pass, getenv("DB_PASS"));
    EXEC SQL CONNECT TO :db_name USER :db_user USING :db_pass;

    checkSQL("Konekcija na bazu podataka");

    EXEC SQL 
        INSERT INTO DA.USLOVNIPREDMET
        VALUES (103, 2343, 2327);
    checkSQL("INSERT");

    printf("Dodato!\n");
    
    EXEC SQL CONNECT RESET;
    checkSQL("Prekidanje konekcije sa bazom podataka");

    return 0;
}
