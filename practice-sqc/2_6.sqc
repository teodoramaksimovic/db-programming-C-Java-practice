#include <stdio.h>
#include <string.h>
#include <stdlib.h>

EXEC SQL INCLUDE SQLCA;

EXEC SQL BEGIN DECLARE SECTION;
char db_name[20];
char db_user[20];
char db_pass[20];
sqlint32 brojac;
short godina;
EXEC SQL END DECLARE SECTION;

void checkSQL(const char *str) {
    if(SQLCODE < 0) {
        fprintf(stderr, "Greska %d: %s\n", SQLCODE, str);

        EXEC SQL CONNECT RESET;
        exit(EXIT_FAILURE);
    }
}

int main()
{
    strcpy(db_name, getenv("DB_NAME"));
    strcpy(db_user, getenv("DB_USER"));
    strcpy(db_pass, getenv("DB_PASS"));
    EXEC SQL CONNECT TO :db_name USER :db_user USING :db_pass;

    checkSQL("Konekcija na bazu podataka");

    printf("Unesite godinu: ");
    scanf("%hd", &godina);

    EXEC SQL 
        SELECT COUNT(*)
        INTO :brojac
        FROM DA.DOSIJE D 
        WHERE D.INDEKS / 10000 = :godina;
    checkSQL("SELECT INTO");
    // ili indeks between :godina*10000 and :godina*10000+9999

    printf("%d\n", brojac);
    
    EXEC SQL CONNECT RESET;
    checkSQL("Prekidanje konekcije sa bazom podataka");

    return 0;
}
