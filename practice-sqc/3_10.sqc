/*
Zadatak 3.10: Napisati C/SQL program koji ispisuje sve napomene koje se nalaze u tabeli ISPIT, navodeći i broj indeksa studenata. 
(Videti napomenu iznad zadatka 3.6 za kreiranje kolone NAPOMENA.)
*/
#include <stdio.h>
#include <stdlib.h>
#include <string.h>

EXEC SQL INCLUDE SQLCA;

EXEC SQL BEGIN DECLARE SECTION;
char db_name[20];
char db_user[20];
char db_pass[20];
char napomena[101];
short napomenaInd;
sqlint32 indeks;
EXEC SQL END DECLARE SECTION;

void checkSQL(const char *str)
{
    if (SQLCODE < 0) {
        fprintf(stderr, "Greska %d: %s\n", SQLCODE, str);

        EXEC SQL ROLLBACK;
        EXEC SQL CONNECT RESET;

        exit(EXIT_FAILURE);
    }
}

int main()
{
    strcpy(db_name, getenv("DB_NAME"));
    strcpy(db_user, getenv("DB_USER"));
    strcpy(db_pass, getenv("DB_PASS"));
    EXEC SQL CONNECT TO :db_name USER :db_user USING :db_pass;

    checkSQL("Konekcija na bazu podataka");
    
    EXEC SQL 
        DECLARE napomene CURSOR FOR 
            SELECT INDEKS, NAPOMENA
            FROM DA.ISPIT;
    checkSQL("DECLARE");

    EXEC SQL OPEN napomene;
    checkSQL("OPEN");

    for(;;){
        EXEC SQL 
            FETCH napomene
            INTO :indeks, :napomena :napomenaInd;
        checkSQL("FETCH");

        if(SQLCODE == 100)
            break;

        printf("%d %s\n", indeks, ((napomenaInd < 0) ? "-" : napomena));
    }

    EXEC SQL CLOSE napomene;
    checkSQL("CLOSE");   

    EXEC SQL CONNECT RESET;
    checkSQL("RESET");

    return 0;
}